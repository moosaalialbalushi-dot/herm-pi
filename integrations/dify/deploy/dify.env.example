# Dify deployment settings for dify.kadindustries.org
#
# These are the keys that actually matter when a Dify instance is served on a
# real domain behind TLS. Merge them into docker/.env in your Dify checkout
# (start from Dify's own .env.example, then set these), and apply with:
#
#   docker compose down && docker compose up -d
#
# A plain `restart` is not enough: the bundled nginx renders its config from
# these variables at container start, so changes need a recreate.

# --- Public URLs -------------------------------------------------------------
# Every one of these must be the external https origin. Dify bakes them into
# the pages it serves and the links it generates; a stale http:// or localhost
# value here is the usual cause of a console that loads but cannot log in.
CONSOLE_API_URL=https://dify.kadindustries.org
CONSOLE_WEB_URL=https://dify.kadindustries.org
SERVICE_API_URL=https://dify.kadindustries.org
APP_API_URL=https://dify.kadindustries.org
APP_WEB_URL=https://dify.kadindustries.org
FILES_URL=https://dify.kadindustries.org

# --- Secrets -----------------------------------------------------------------
# Generate once, then never rotate casually: it encrypts stored provider
# credentials, and changing it makes existing model credentials undecryptable.
#   openssl rand -base64 42
SECRET_KEY=

# Set before first boot to pre-seed the admin password on /install.
INIT_PASSWORD=

# --- Bundled nginx -----------------------------------------------------------
NGINX_SERVER_NAME=dify.kadindustries.org

# Set to false when TLS is terminated upstream (Cloudflare proxy, a Cloudflare
# Tunnel, or your own reverse proxy) and this nginx only serves plain HTTP.
NGINX_HTTPS_ENABLED=false
NGINX_SSL_CERT_FILENAME=dify.kadindustries.org.crt
NGINX_SSL_CERT_KEY_FILENAME=dify.kadindustries.org.key
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3

# Ports published on the host. Bind to loopback when something else fronts it:
#   EXPOSE_NGINX_PORT=127.0.0.1:8080
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443

# Uploads: this must be >= UPLOAD_FILE_SIZE_LIMIT below, and <= whatever the
# upstream proxy allows (Cloudflare's free/pro plans cap request bodies at
# 100 MB), or uploads fail with 413 at whichever hop is smallest.
NGINX_CLIENT_MAX_BODY_SIZE=100M

# Long workflow runs hold the connection open; keep these generous.
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s

# --- Upload limits (application side) ----------------------------------------
UPLOAD_FILE_SIZE_LIMIT=50
UPLOAD_FILE_BATCH_LIMIT=5
UPLOAD_IMAGE_FILE_SIZE_LIMIT=10

# --- CORS --------------------------------------------------------------------
# Wildcards work but let any origin drive the console API from a browser.
CONSOLE_CORS_ALLOW_ORIGINS=https://dify.kadindustries.org
WEB_API_CORS_ALLOW_ORIGINS=*

# --- Database migrations -----------------------------------------------------
# Runs pending migrations on api container start. Leave on for compose upgrades.
MIGRATION_ENABLED=true

# --- Plugin daemon (Dify 1.x) ------------------------------------------------
# Both must be set and must match across the api and plugin_daemon services, or
# the plugin daemon stays unreachable and every plugin-backed tool errors.
PLUGIN_DAEMON_KEY=
PLUGIN_DIFY_INNER_API_KEY=
